/* Non-localizable resources for Pointcloud4Archicad Add-On */

/* Registrierte Graphisoft Developer ID + Local ID für "dynamic_pointcloud" */
'MDID' 32500 "Add-On Identifier" {
	709315661
	1905536138
}

/* Palette-Icons: einmalig aus Archicad 26 (macOS, Contents/Resources/<id>.tif) kopiert,
   1x und @2x als PNG in RFIX/Images. Eigene Ressourcen statt RSGetApplicationResModule,
   weil Archicads Icon-IDs nur im Mac-Bundle gelten — unter Windows blieb die Palette leer.
   Herkunfts-IDs siehe PwIconId in PunktwolkenPalette.cpp. */

'GICN' 32401 "Import" {
	"PW_Add"
}

'GICN' 32402 "Einstellungen" {
	"PW_Settings"
}

'GICN' 32403 "Loeschen" {
	"PW_Delete"
}

'GICN' 32404 "Auge offen" {
	"PW_EyeOpen"
}

'GICN' 32405 "Auge zu" {
	"PW_EyeClosed"
}

'GICN' 32406 "Geschoss" {
	"PW_Story"
}

'GICN' 32407 "Standort" {
	"PW_Scan"
}

'GICN' 32408 "Punktwolke" {
	"PW_Cloud"
}

/* Hover-Fassungen der Werkzeugleiste: erzeugt von tools/make-hover-svg.py
   aus den Basis-SVGs. Als echte Ressource, weil der graue Hintergrund frueher
   zur Laufzeit gemalt wurde — unter Windows gibt es dafuer keinen Zeichenpfad,
   dort kam ein leeres Icon heraus und die Leiste zeigte gefuellte Bloecke. */
'GICN' 32409 "Import hover" {
	"PW_AddHover"
}

'GICN' 32410 "Einstellungen hover" {
	"PW_SettingsHover"
}

'GICN' 32411 "Loeschen hover" {
	"PW_DeleteHover"
}
